{
  "name": "pfe-cit-gabarits",
  "private": true,
  "description": "Compilation Tailwind du CSS versionné — outillage de poste de développement uniquement, absent du poste cible (BNF-06).",
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-static": "^1.39.0",
    "tailwindcss": "3.4.14"
  },
  "scripts": {
    "css:build": "tailwindcss -c tailwind.config.js -i app/noyau/static_src/application.css -o app/noyau/static/css/application.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i app/noyau/static_src/application.css -o app/noyau/static/css/application.css --watch",
    "polices:copier": "node scripts/copier-polices.mjs",
    "icones:construire": "node scripts/construire-planche-icones.mjs"
  }
}
