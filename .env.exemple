# Copier en .env (non versionné) et ajuster.
# Aucune valeur réelle du CIT ici : uniquement des exemples de développement.

# --- Production uniquement (aucun défaut permissif — voir config/settings/production.py) ---
SECRET_KEY=
ALLOWED_HOSTS=

# --- Base de données ---
BASE_NOM=pfe_cit
BASE_HOTE=localhost
BASE_PORT=5432

# Rôle applicatif (utilisé par défaut en local et en production)
BASE_UTILISATEUR=pfe_cit_app
BASE_MOT_DE_PASSE=developpement_local_app

# Rôle de migration — nécessaire pour `manage.py migrate` et pour la suite de
# tests (seul ce rôle peut créer/détruire la base de test). Surcharger
# BASE_UTILISATEUR / BASE_MOT_DE_PASSE avec ces valeurs pour lancer migrate.
BASE_UTILISATEUR_MIGRATION=pfe_cit_migration
BASE_MOT_DE_PASSE_MIGRATION=developpement_local_migration

# --- Paramétrable (BNF-13) ---
TAILLE_PAGE_DEFAUT=20

# Provisoires, à confirmer auprès du chef de bureau pédagogique — voir
# docs/suivi/DECISIONS.md et referentiel/services/referentiel.py
VOLUME_HORAIRE_HEBDOMADAIRE_REFERENCE=30
SEUIL_ECART_VOLUME_REFERENTIEL_POURCENT=10
